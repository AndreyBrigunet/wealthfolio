+fn configured_connect_origin(name: &str) -> Option<String> {
+    let value = std::env::var(name).ok()?;
+    let uri = value.trim().parse::<Uri>().ok()?;
+    let scheme = uri.scheme_str()?;
+    if scheme != "http" && scheme != "https" {
+        return None;
+    }
+    let authority = uri.authority()?;
+
+    Some(format!("{scheme}://{authority}"))
+}
+
+fn server_csp_header_value() -> HeaderValue {
+    let mut origins = Vec::new();
+    for name in ["CONNECT_AUTH_URL", "CONNECT_API_URL"] {
+        if let Some(origin) = configured_connect_origin(name) {
+            if !origins.contains(&origin) {
+                origins.push(origin);
+            }
+        }
+    }
+
+    if origins.is_empty() {
+        return HeaderValue::from_static(SERVER_CSP);
+    }
+
+    let csp = SERVER_CSP.replacen(
+        "; frame-src",
+        &format!(" {}; frame-src", origins.join(" ")),
+        1,
+    );
+    HeaderValue::from_str(&csp).unwrap_or_else(|_| HeaderValue::from_static(SERVER_CSP))
+}
